<aside class="admin-sidebar">
    <div class="admin-brand">
        <div class="admin-brand-mark">EV</div>
        <div>
            <div class="admin-brand-title">E-Vehicle Admin</div>
            <div class="admin-brand-subtitle">Finance and operations</div>
        </div>
    </div>

    <div class="admin-user">
        <strong><c:out value="${adminAccount.fullName}"/></strong>
        <span>ADMIN ACCESS</span>
    </div>

    <nav class="admin-nav-group">
        <div class="admin-nav-label">Overview</div>
        <a class="admin-nav-link ${activeModule eq 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-dashboard"><span class="admin-nav-icon">D</span>Dashboard</a>
        <a class="admin-nav-link ${activeModule eq 'financial' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-financial-reports"><span class="admin-nav-icon">F</span>Financial Reports</a>
        <a class="admin-nav-link ${activeModule eq 'station-performance' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-station-performance"><span class="admin-nav-icon">S</span>Station Performance</a>
        <a class="admin-nav-link ${activeModule eq 'model-performance' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-model-performance"><span class="admin-nav-icon">M</span>Model Performance</a>

        <div class="admin-nav-label">Master Data</div>
        <a class="admin-nav-link ${activeModule eq 'accounts' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-accounts"><span class="admin-nav-icon">A</span>Accounts</a>
        <a class="admin-nav-link ${activeModule eq 'stations' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-stations"><span class="admin-nav-icon">ST</span>Stations</a>
        <a class="admin-nav-link ${activeModule eq 'categories' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-categories"><span class="admin-nav-icon">C</span>Categories</a>
        <a class="admin-nav-link ${activeModule eq 'vehicle-models' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-vehicle-models"><span class="admin-nav-icon">VM</span>Vehicle Models</a>
        <a class="admin-nav-link ${activeModule eq 'vehicle-model-images' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-vehicle-model-images"><span class="admin-nav-icon">IM</span>Model Images</a>
        <a class="admin-nav-link ${activeModule eq 'vehicles' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-vehicles"><span class="admin-nav-icon">V</span>Vehicles</a>
        <a class="admin-nav-link ${activeModule eq 'discounts' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-discounts"><span class="admin-nav-icon">%</span>Discounts</a>

        <div class="admin-nav-label">Transactions</div>
        <a class="admin-nav-link ${activeModule eq 'rentals' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-rentals"><span class="admin-nav-icon">R</span>Rentals</a>
        <a class="admin-nav-link ${activeModule eq 'rental-status-history' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-rental-status-history"><span class="admin-nav-icon">H</span>Status History</a>
        <a class="admin-nav-link ${activeModule eq 'payments' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-payments"><span class="admin-nav-icon">P</span>Payments</a>
        <a class="admin-nav-link ${activeModule eq 'extra-charges' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-extra-charges"><span class="admin-nav-icon">EC</span>Extra Charges</a>
        <a class="admin-nav-link ${activeModule eq 'rental-discounts' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-rental-discounts"><span class="admin-nav-icon">RD</span>Rental Discounts</a>
        <a class="admin-nav-link ${activeModule eq 'wallets' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-wallets"><span class="admin-nav-icon">W</span>Wallets</a>
        <a class="admin-nav-link ${activeModule eq 'wallet-transactions' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-wallet-transactions"><span class="admin-nav-icon">WT</span>Wallet Transactions</a>

        <div class="admin-nav-label">Operations</div>
        <a class="admin-nav-link ${activeModule eq 'incidents' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-incidents"><span class="admin-nav-icon">I</span>Incidents</a>
        <a class="admin-nav-link ${activeModule eq 'maintenance' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-maintenance"><span class="admin-nav-icon">MT</span>Maintenance</a>

        <div class="admin-nav-label">Account</div>
        <a class="admin-nav-link ${activeModule eq 'profile' ? 'active' : ''}" href="${pageContext.request.contextPath}?action=admin-profile"><span class="admin-nav-icon">U</span>Profile</a>
        <a class="admin-nav-link logout" href="${pageContext.request.contextPath}?action=logout"><span class="admin-nav-icon">X</span>Logout</a>
    </nav>
</aside>
