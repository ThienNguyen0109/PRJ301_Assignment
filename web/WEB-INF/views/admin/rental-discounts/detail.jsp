<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Rental Discount Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Rental Discount Detail</h2><p>Discount usage is generated by the booking flow and should not be manually edited.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-rental-discounts">Back</a></div>
<c:choose><c:when test="${empty rentalDiscount}"><div class="admin-message error">Rental discount record not found.</div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item"><span>Usage ID</span><strong><c:out value="${rentalDiscount.rentalDiscountId}"/></strong></div><div class="admin-detail-item"><span>Rental ID</span><strong><c:out value="${rentalDiscount.rentalId}"/></strong></div><div class="admin-detail-item"><span>Discount ID</span><strong><c:out value="${rentalDiscount.discountId}"/></strong></div><div class="admin-detail-item"><span>Discount Code</span><strong><c:out value="${rentalDiscount.discountCode}"/> - <c:out value="${rentalDiscount.discountPercent}"/>%</strong></div><div class="admin-detail-item"><span>Customer</span><strong><c:out value="${rentalDiscount.customerName}"/></strong><small><c:out value="${rentalDiscount.customerEmail}"/></small></div><div class="admin-detail-item"><span>Rental Period</span><strong><fmt:formatDate value="${rentalDiscount.startDate}" pattern="dd/MM/yyyy"/> - <fmt:formatDate value="${rentalDiscount.endDate}" pattern="dd/MM/yyyy"/></strong></div></div></c:otherwise></c:choose>
</section></div></main></div></body></html>
