<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Incident Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content"><section class="admin-panel"><div class="admin-panel-header"><div><h2>Incident Detail</h2><p>Vehicle damage assessment.</p></div><div class="inline-actions"><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-incidents">Back</a><c:if test="${not empty incident}"><a class="admin-button" href="${pageContext.request.contextPath}?action=admin-incident-form&id=${incident.incidentId}">Edit</a></c:if></div></div><c:choose><c:when test="${not empty incident}"><div class="admin-detail-grid"><div class="admin-detail-item"><span>Severity</span><strong><c:out value="${incident.severity}"/></strong></div><div class="admin-detail-item"><span>Created</span><strong><fmt:formatDate value="${incident.createdAt}" pattern="dd/MM/yyyy HH:mm"/></strong></div><div class="admin-detail-item"><span>Vehicle</span><strong><c:out value="${incident.vehicleModelName}"/> · <c:out value="${incident.licensePlate}"/></strong></div><div class="admin-detail-item"><span>Rental ID</span><strong><c:out value="${incident.rentalId}"/></strong></div><div class="admin-detail-item full"><span>Description</span><strong><c:out value="${incident.description}"/></strong></div><div class="admin-detail-item full"><span>Incident ID</span><strong><c:out value="${incident.incidentId}"/></strong></div></div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item full"><strong>Incident not found.</strong></div></div></c:otherwise></c:choose></section></div></main></div></body></html>
