<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Create Maintenance - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<c:if test="${not empty adminError}"><div class="admin-message error"><c:out value="${adminError}"/></div></c:if>
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Create Maintenance</h2><p>The selected vehicle must not have active BOOKED or RENTED rentals.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-maintenance">Back</a></div>
<form class="admin-form" action="${pageContext.request.contextPath}/admin/maintenance/save" method="POST"><div class="admin-form-grid"><div class="admin-field full"><label>Vehicle</label><select name="vehicleId" required><option value="">Choose vehicle</option><c:forEach var="vehicle" items="${vehicles}"><option value="${vehicle.vehicleId}">${vehicle.model.name} - ${vehicle.licensePlate} - ${vehicle.status}</option></c:forEach></select></div><div class="admin-field full"><label>Description</label><textarea name="description" required rows="4" maxlength="500" placeholder="Describe maintenance reason"></textarea></div></div><div class="admin-form-actions"><button class="admin-button" type="submit">Create Maintenance</button><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-maintenance">Cancel</a></div></form>
</section></div></main></div></body></html>
