<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Maintenance Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<c:if test="${not empty adminSuccess}"><div class="admin-message success"><c:out value="${adminSuccess}"/></div></c:if><c:if test="${not empty adminError}"><div class="admin-message error"><c:out value="${adminError}"/></div></c:if>
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Maintenance Detail</h2><p>Repair and inspection status.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-maintenance">Back</a></div>
<c:choose><c:when test="${empty maintenance}"><div class="admin-message error">Maintenance record not found.</div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item"><span>Maintenance ID</span><strong><c:out value="${maintenance.maintenanceId}"/></strong></div><div class="admin-detail-item"><span>Vehicle</span><strong><c:out value="${maintenance.modelName}"/> - <c:out value="${maintenance.licensePlate}"/></strong></div><div class="admin-detail-item"><span>Station</span><strong><c:out value="${maintenance.stationName}"/></strong></div><div class="admin-detail-item"><span>Status</span><strong><c:out value="${maintenance.status}"/></strong></div><div class="admin-detail-item"><span>Vehicle Status</span><strong><c:out value="${maintenance.vehicleStatus}"/></strong></div><div class="admin-detail-item"><span>Date</span><strong><fmt:formatDate value="${maintenance.maintenanceDate}" pattern="dd/MM/yyyy HH:mm"/></strong></div><div class="admin-detail-item full"><span>Description</span><strong><c:out value="${maintenance.description}"/></strong></div></div><c:if test="${maintenance.canComplete}"><div class="admin-form-actions"><form method="POST" action="${pageContext.request.contextPath}/admin/maintenance/complete" onsubmit="return confirm('Mark this maintenance as completed?');"><input type="hidden" name="maintenanceId" value="${maintenance.maintenanceId}"><button class="admin-button" type="submit">Mark Completed</button></form></div></c:if></c:otherwise></c:choose>
</section></div></main></div></body></html>
