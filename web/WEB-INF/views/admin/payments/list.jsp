<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Payments - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<c:if test="${not empty adminSuccess}"><div class="admin-message success"><c:out value="${adminSuccess}"/></div></c:if><c:if test="${not empty adminError}"><div class="admin-message error"><c:out value="${adminError}"/></div></c:if>
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Payment Management</h2><p>Review payment records. Amounts and completed records cannot be edited.</p></div></div>
<form class="form-row" action="${pageContext.request.contextPath}/" method="GET"><input type="hidden" name="action" value="admin-payments"><input type="search" name="keyword" value="${keyword}" placeholder="Payment, rental, customer, transaction"><select name="method"><option value="ALL">All Methods</option><c:forEach var="item" items="${paymentMethods}"><option value="${item}" ${selectedMethod == item.name() ? 'selected' : ''}>${item}</option></c:forEach></select><select name="type"><option value="ALL">All Types</option><c:forEach var="item" items="${paymentTypes}"><option value="${item}" ${selectedType == item.name() ? 'selected' : ''}>${item}</option></c:forEach></select><select name="status"><option value="ALL">All Statuses</option><c:forEach var="item" items="${paymentStatuses}"><option value="${item}" ${selectedStatus == item.name() ? 'selected' : ''}>${item}</option></c:forEach></select><button class="admin-button" type="submit">Filter</button></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Payment</th><th>Customer</th><th>Method / Type</th><th>Amount</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead><tbody><c:forEach var="payment" items="${payments}"><tr><td><strong><c:out value="${payment.paymentId}"/></strong><br><small><c:out value="${payment.rentalId}"/></small></td><td><c:out value="${payment.customerName}"/><br><small><c:out value="${payment.customerEmail}"/></small></td><td><c:out value="${payment.paymentMethod}"/> / <c:out value="${payment.paymentType}"/></td><td><fmt:formatNumber value="${payment.amount}" pattern="#,##0"/> VND</td><td><span class="status-chip"><c:out value="${payment.status}"/></span></td><td><fmt:formatDate value="${payment.paymentDate}" pattern="dd/MM/yyyy HH:mm"/></td><td><div class="inline-actions"><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-payment-detail&id=${payment.paymentId}">View</a><c:if test="${payment.canConfirmCash}"><form class="inline-form" method="POST" action="${pageContext.request.contextPath}/admin/payments/confirm-cash" onsubmit="return confirm('Confirm this CASH payment?');"><input type="hidden" name="paymentId" value="${payment.paymentId}"><button class="admin-button" type="submit">Confirm Cash</button></form></c:if><c:if test="${payment.canMarkFailed}"><form class="inline-form" method="POST" action="${pageContext.request.contextPath}/admin/payments/fail" onsubmit="return confirm('Mark this pending payment as failed?');"><input type="hidden" name="paymentId" value="${payment.paymentId}"><button class="danger-button" type="submit">Mark Failed</button></form></c:if></div></td></tr></c:forEach><c:if test="${empty payments}"><tr><td colspan="7">No payments found.</td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jspf/admin-pagination.jspf" %></section>
</div></main></div></body></html>
