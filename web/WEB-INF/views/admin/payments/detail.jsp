<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Payment Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content"><section class="admin-panel"><div class="admin-panel-header"><div><h2>Payment Detail</h2><p>Financial record details.</p></div><div class="inline-actions"><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-payments">Back</a><c:if test="${payment.canConfirmCash}"><form class="inline-form" method="POST" action="${pageContext.request.contextPath}/admin/payments/confirm-cash"><input type="hidden" name="paymentId" value="${payment.paymentId}"><button class="admin-button" type="submit">Confirm Cash</button></form></c:if><c:if test="${payment.canMarkFailed}"><form class="inline-form" method="POST" action="${pageContext.request.contextPath}/admin/payments/fail"><input type="hidden" name="paymentId" value="${payment.paymentId}"><button class="danger-button" type="submit">Mark Failed</button></form></c:if></div></div><c:choose><c:when test="${not empty payment}"><div class="admin-detail-grid"><div class="admin-detail-item"><span>Status</span><strong><c:out value="${payment.status}"/></strong></div><div class="admin-detail-item"><span>Amount</span><strong><fmt:formatNumber value="${payment.amount}" pattern="#,##0"/> VND</strong></div><div class="admin-detail-item"><span>Customer</span><strong><c:out value="${payment.customerName}"/></strong></div><div class="admin-detail-item"><span>Email</span><strong><c:out value="${payment.customerEmail}"/></strong></div><div class="admin-detail-item"><span>Method</span><strong><c:out value="${payment.paymentMethod}"/></strong></div><div class="admin-detail-item"><span>Type</span><strong><c:out value="${payment.paymentType}"/></strong></div><div class="admin-detail-item full"><span>Transaction Code</span><strong><c:out value="${empty payment.transactionCode ? '-' : payment.transactionCode}"/></strong></div><div class="admin-detail-item full"><span>Rental ID</span><strong><c:out value="${payment.rentalId}"/></strong></div><div class="admin-detail-item full"><span>Payment ID</span><strong><c:out value="${payment.paymentId}"/></strong></div></div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item full"><strong>Payment not found.</strong></div></div></c:otherwise></c:choose></section></div></main></div></body></html>
