<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Wallet Transaction Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Wallet Transaction Detail</h2><p>Immutable wallet transaction record.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-wallet-transactions">Back</a></div>
<c:choose><c:when test="${empty walletTransaction}"><div class="admin-message error">Wallet transaction not found.</div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item"><span>Transaction ID</span><strong><c:out value="${walletTransaction.transactionId}"/></strong></div><div class="admin-detail-item"><span>Wallet ID</span><strong><c:out value="${walletTransaction.walletId}"/></strong></div><div class="admin-detail-item"><span>Customer</span><strong><c:out value="${walletTransaction.customerName}"/></strong><small><c:out value="${walletTransaction.customerEmail}"/></small></div><div class="admin-detail-item"><span>Type</span><strong><c:out value="${walletTransaction.type}"/></strong></div><div class="admin-detail-item"><span>Amount</span><strong><fmt:formatNumber value="${walletTransaction.amount}" pattern="#,##0"/> VND</strong></div><div class="admin-detail-item"><span>Created At</span><strong><fmt:formatDate value="${walletTransaction.createdAt}" pattern="dd/MM/yyyy HH:mm"/></strong></div><div class="admin-detail-item full"><span>Description</span><strong><c:out value="${walletTransaction.description}"/></strong></div></div></c:otherwise></c:choose>
</section></div></main></div></body></html>
