<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Status History Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Status History Detail</h2><p>Audit record for a rental status transition.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-rental-status-history">Back</a></div>
<c:choose><c:when test="${empty historyRow}"><div class="admin-message error">History record not found.</div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item"><span>History ID</span><strong><c:out value="${historyRow.historyId}"/></strong></div><div class="admin-detail-item"><span>Rental ID</span><strong><c:out value="${historyRow.rentalId}"/></strong></div><div class="admin-detail-item"><span>Customer</span><strong><c:out value="${historyRow.customerName}"/></strong><small><c:out value="${historyRow.customerEmail}"/></small></div><div class="admin-detail-item"><span>Vehicle</span><strong><c:out value="${historyRow.vehicleName}"/> - <c:out value="${historyRow.licensePlate}"/></strong></div><div class="admin-detail-item"><span>Status</span><strong><c:out value="${historyRow.status}"/></strong></div><div class="admin-detail-item"><span>Changed At</span><strong><fmt:formatDate value="${historyRow.changedAt}" pattern="dd/MM/yyyy HH:mm"/></strong></div></div></c:otherwise></c:choose>
</section></div></main></div></body></html>
