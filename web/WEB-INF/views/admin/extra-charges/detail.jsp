<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Extra Charge Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Extra Charge Detail</h2><p>Finance-side extra fee record.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-extra-charges">Back</a></div>
<c:choose><c:when test="${empty charge}"><div class="admin-message error">Extra charge not found.</div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item"><span>Charge ID</span><strong><c:out value="${charge.chargeId}"/></strong></div><div class="admin-detail-item"><span>Rental ID</span><strong><c:out value="${charge.rentalId}"/></strong></div><div class="admin-detail-item"><span>Customer</span><strong><c:out value="${charge.customerName}"/></strong><small><c:out value="${charge.customerEmail}"/></small></div><div class="admin-detail-item"><span>Vehicle</span><strong><c:out value="${charge.vehicleName}"/> - <c:out value="${charge.licensePlate}"/></strong></div><div class="admin-detail-item"><span>Type</span><strong><c:out value="${charge.chargeType}"/></strong></div><div class="admin-detail-item"><span>Amount</span><strong><fmt:formatNumber value="${charge.amount}" pattern="#,##0"/> VND</strong></div><div class="admin-detail-item"><span>Status</span><strong><c:out value="${charge.status}"/></strong></div><div class="admin-detail-item"><span>Created At</span><strong><fmt:formatDate value="${charge.createdAt}" pattern="dd/MM/yyyy HH:mm"/></strong></div><div class="admin-detail-item full"><span>Description</span><strong><c:out value="${charge.description}"/></strong></div></div><c:if test="${charge.canEdit}"><div class="admin-form-actions"><a class="admin-button" href="${pageContext.request.contextPath}?action=admin-extra-charge-form&id=${charge.chargeId}">Edit Charge</a></div></c:if></c:otherwise></c:choose>
</section></div></main></div></body></html>
