<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Category Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Category Detail</h2><p>Vehicle grouping record.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-categories">Back</a></div>
<c:choose><c:when test="${empty category}"><div class="admin-message error">Category not found.</div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item"><span>Category ID</span><strong><c:out value="${category.categoryId}"/></strong></div><div class="admin-detail-item"><span>Name</span><strong><c:out value="${category.name}"/></strong></div></div><div class="admin-form-actions"><a class="admin-button" href="${pageContext.request.contextPath}?action=admin-category-form&id=${category.categoryId}">Edit Category</a></div></c:otherwise></c:choose>
</section></div></main></div></body></html>
