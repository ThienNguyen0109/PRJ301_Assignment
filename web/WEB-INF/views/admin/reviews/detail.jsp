<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Review Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content">
<section class="admin-panel"><div class="admin-panel-header"><div><h2>Review Detail</h2><p>Customer feedback record.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-reviews">Back</a></div>
<c:choose><c:when test="${empty review}"><div class="admin-message error">Review not found.</div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item"><span>Review ID</span><strong><c:out value="${review.reviewId}"/></strong></div><div class="admin-detail-item"><span>Rental ID</span><strong><c:out value="${review.rentalId}"/></strong></div><div class="admin-detail-item"><span>Customer</span><strong><c:out value="${review.customerName}"/></strong><small><c:out value="${review.customerEmail}"/></small></div><div class="admin-detail-item"><span>Vehicle Model</span><strong><c:out value="${review.modelName}"/></strong></div><div class="admin-detail-item"><span>Rating</span><strong><c:out value="${review.rating}"/> / 5</strong></div><div class="admin-detail-item"><span>Created At</span><strong><fmt:formatDate value="${review.createdAt}" pattern="dd/MM/yyyy HH:mm"/></strong></div><div class="admin-detail-item full"><span>Comment</span><strong><c:out value="${review.comment}"/></strong></div></div></c:otherwise></c:choose>
</section></div></main></div></body></html>
