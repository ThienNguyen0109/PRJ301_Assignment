<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Wallets - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content"><c:if test="${not empty adminSuccess}"><div class="admin-message success"><c:out value="${adminSuccess}"/></div></c:if><c:if test="${not empty adminError}"><div class="admin-message error"><c:out value="${adminError}"/></div></c:if><section class="admin-panel"><div class="admin-panel-header"><div><h2>Wallet Management</h2><p>Read-only customer balances and transaction audit records.</p></div></div><form class="form-row" action="${pageContext.request.contextPath}/" method="GET"><input type="hidden" name="action" value="admin-wallets"><input type="search" name="keyword" value="${keyword}" placeholder="Customer name, email, or phone"><button class="admin-button" type="submit">Filter</button></form><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Customer</th><th>Email / Phone</th><th>Balance</th><th>Updated At</th><th>Actions</th></tr></thead><tbody><c:forEach var="wallet" items="${wallets}"><tr><td><strong><c:out value="${wallet.customerName}"/></strong></td><td><c:out value="${wallet.customerEmail}"/><br><small><c:out value="${wallet.customerPhone}"/></small></td><td><strong><fmt:formatNumber value="${wallet.balance}" pattern="#,##0"/> VND</strong></td><td><fmt:formatDate value="${wallet.updatedAt}" pattern="dd/MM/yyyy HH:mm"/></td><td><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-wallet-detail&id=${wallet.walletId}">View Activity</a></td></tr></c:forEach><c:if test="${empty wallets}"><tr><td colspan="5">No wallets found.</td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jspf/admin-pagination.jspf" %></section></div></main></div></body></html>
