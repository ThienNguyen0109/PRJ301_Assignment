<%@page contentType="text/html" pageEncoding="UTF-8"%><%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%><%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Wallet Detail - Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css"></head><body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/jspf/admin-sidebar.jspf" %><main class="admin-main"><%@ include file="/WEB-INF/jspf/admin-topbar.jspf" %><div class="admin-content"><section class="admin-panel"><div class="admin-panel-header"><div><h2>Wallet Detail</h2><p>Balance is changed only by the customer payment and top-up flows.</p></div><a class="admin-button light" href="${pageContext.request.contextPath}?action=admin-wallets">Back</a></div><c:choose><c:when test="${not empty wallet}"><div class="admin-detail-grid"><div class="admin-detail-item"><span>Customer</span><strong><c:out value="${wallet.customerName}"/></strong></div><div class="admin-detail-item"><span>Balance</span><strong><fmt:formatNumber value="${wallet.balance}" pattern="#,##0"/> VND</strong></div><div class="admin-detail-item"><span>Email</span><strong><c:out value="${wallet.customerEmail}"/></strong></div><div class="admin-detail-item"><span>Phone</span><strong><c:out value="${wallet.customerPhone}"/></strong></div><div class="admin-detail-item full"><span>Wallet ID</span><strong><c:out value="${wallet.walletId}"/></strong></div></div><h3>Transaction History</h3><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Type</th><th>Amount</th><th>Description</th><th>Created At</th></tr></thead><tbody><c:forEach var="transaction" items="${walletTransactions}"><tr><td><span class="status-chip"><c:out value="${transaction.type}"/></span></td><td><fmt:formatNumber value="${transaction.amount}" pattern="#,##0"/> VND</td><td><c:out value="${transaction.description}"/></td><td><fmt:formatDate value="${transaction.createdAt}" pattern="dd/MM/yyyy HH:mm"/></td></tr></c:forEach><c:if test="${empty walletTransactions}"><tr><td colspan="4">No wallet transactions found.</td></tr></c:if></tbody></table></div></c:when><c:otherwise><div class="admin-detail-grid"><div class="admin-detail-item full"><strong>Wallet not found.</strong></div></div></c:otherwise></c:choose></section></div></main></div></body></html>
